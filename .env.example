# GEMINI_API_KEY: Required for server-side Gemini AI assistant & visual search.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key (restrict by HTTP referrer & enabled APIs).
VITE_GOOGLE_MAPS_API_KEY=""

# Google AdSense / Ad Manager configuration (kept disabled until publisher setup is complete).
VITE_ADSENSE_CLIENT_ID=""
VITE_ADSENSE_SLOT_HOME=""
VITE_ADSENSE_SLOT_SEARCH=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_INFO=""

# WhatsApp Customer OTP Delivery (optional env overrides; can also be linked via QR or configured in Admin -> WhatsApp Gateway)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="ar"
WHATSAPP_WEBHOOK_URL=""
WHATSAPP_WEBHOOK_TOKEN=""
OTP_SIGNING_SECRET=""
